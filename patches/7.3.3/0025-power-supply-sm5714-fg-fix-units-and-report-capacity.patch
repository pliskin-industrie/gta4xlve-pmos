+static int sm5714_fg_read_sram(struct sm5714_fg *drv, u8 addr)
+{
+	int ret;
+
+	mutex_lock(&drv->lock);
+	ret = i2c_smbus_write_word_data(drv->i2c, SM5714_FG_REG_SRAM_RADDR, addr);
+	if (!ret)
+		ret = i2c_smbus_read_word_data(drv->i2c, SM5714_FG_REG_SRAM_RDATA);
+	mutex_unlock(&drv->lock);
+
+	return ret;
+}
+
+/* Battery voltage in uV: 2700 mV +/- raw * 10 / 109 mV */
+static int sm5714_fg_vbat(struct sm5714_fg *drv, u8 addr, int *uv)
+{
+	int raw = sm5714_fg_read_sram(drv, addr);
+	int mv;
+
+	if (raw < 0)
+		return raw;
+
+	if (raw & SM5714_FG_SIGN)
+		mv = 2700 - ((raw & 0x7fff) * 10) / 109;
+	else
+		mv = 2700 + (raw * 10) / 109;
+
+	*uv = mv * 1000;
+	return 0;
+}
+
+/* OCV in uV: unsigned 5.11 fixed point volts */
+static int sm5714_fg_ocv(struct sm5714_fg *drv, int *uv)
+{
+	int raw = sm5714_fg_read_sram(drv, SM5714_FG_ADDR_SRAM_OCV);
+
+	if (raw < 0)
+		return raw;
+
+	*uv = (int)(((u64)raw * 1000000) >> 11);
+	return 0;
+}
+
+/*
+ * Current in uA: sign + magnitude, 1 A = 2044 LSB, x2.5 in high range.
+ * Positive while charging, negative while discharging (power_supply ABI).
+ */
+static int sm5714_fg_current(struct sm5714_fg *drv, u8 addr, int *ua)
+{
+	int raw, aux, sys;
+	s64 val;
+
+	raw = sm5714_fg_read_sram(drv, addr);
+	if (raw < 0)
+		return raw;
+
+	aux = i2c_smbus_read_word_data(drv->i2c, SM5714_FG_REG_AUX_STAT);
+	if (aux < 0)
+		return aux;
+
+	sys = i2c_smbus_read_word_data(drv->i2c, SM5714_FG_REG_SYSTEM_STATUS);
+	if (sys < 0)
+		return sys;
+
+	val = div_s64((s64)(raw & 0x7fff) * 1000000, 2044);
+	if (aux & SM5714_FG_AUX_CURR_X2_5)
+		val = div_s64(val * 25, 10);
+	if (raw & SM5714_FG_SIGN)
+		val = -val;
+	/* Factory jig attached: current measurement is not valid */
+	if (sys & SM5714_FG_STATUS_JIG)
+		val = 0;
+
+	*ua = (int)val;
+	return 0;
+}
+
+/* State of charge in 0.1 %: unsigned 8.8 fixed point percent */
+static int sm5714_fg_soc_permille(struct sm5714_fg *drv, int *permille)
+{
+	int raw = sm5714_fg_read_sram(drv, SM5714_FG_ADDR_SRAM_SOC);
+
+	if (raw < 0)
+		return raw;
+
+	*permille = clamp((raw * 10) >> 8, 0, 1000);
+	return 0;
+}
