-	struct power_supply *psy;
+	drv->charge_full_design_uah = SM5714_FG_DEFAULT_CHARGE_FULL_UAH;
+	drv->voltage_min_design_uv = 3400000;
+	drv->voltage_max_design_uv = 4400000;
