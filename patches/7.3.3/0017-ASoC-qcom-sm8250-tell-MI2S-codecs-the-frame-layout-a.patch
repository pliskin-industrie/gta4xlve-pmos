From 9c5a7e770fa928db84c2c9094f35933654c6a06d Mon Sep 17 00:00:00 2001
From: Viktor Zaritskyi <viktorzarickiy@gmail.com>
Date: Mon, 7 Sep 2026 10:18:49 +0300
Subject: [PATCH 17/25] ASoC: qcom: sm8250: tell MI2S codecs the frame layout,
 and tell all of them

MI2S_BCLK_RATE is 48000 * 2 * 16, so the frame carries two 16-bit slots, but
nothing ever said so to the codecs. A tas2562 comes out of reset expecting
32-bit slots and then looks for its second slot past the end of the frame, so
the amplifier assigned to the right channel plays nothing while the mixer
controls, the DAPM widgets and even the codec's own registers all read exactly
as they should. Call snd_soc_dai_set_tdm_slot() with the layout the bit clock
actually provides.

Apply the codec-side format to every codec on the link while here: an MI2S
link can carry a stereo pair of amplifiers, and only the first was configured.

Assisted-by: Claude:claude-opus-5
(cherry picked from commit e969a5ec5524a387eae3c4db129a8434372ffb2a)
---
 sound/soc/qcom/sm8250.c | 37 ++++++++++++++++++++++++++++++++-----
 1 file changed, 32 insertions(+), 5 deletions(-)

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index e0549b34f6..d9358f3716 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -17,6 +17,15 @@
 #include "sdw.h"
 
 #define MI2S_BCLK_RATE		1536000
+/*
+ * That bit clock carries two 16-bit slots per frame at 48 kHz. Say so to the
+ * codecs rather than leaving them to assume it: a tas2562 comes out of reset
+ * expecting 32-bit slots, so it looks for its second slot past the end of the
+ * frame and that channel stays silent -- while the mixer, the DAPM widgets and
+ * the codec's own registers all look perfectly correct.
+ */
+#define MI2S_SLOTS		2
+#define MI2S_SLOT_WIDTH		16
 
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
@@ -71,6 +80,24 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	return 0;
 }
 
+/*
+ * Configure every codec on the link, not just the first: an MI2S link can carry
+ * more than one, such as a stereo pair of speaker amplifiers. Codecs with no
+ * .set_tdm_slot answer -ENOTSUPP, which is not an error here.
+ */
+static void sm8250_snd_mi2s_codec_setup(struct snd_soc_pcm_runtime *rtd,
+					unsigned int codec_dai_fmt)
+{
+	struct snd_soc_dai *codec_dai;
+	int i;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		snd_soc_dai_set_tdm_slot(codec_dai, 0x3, 0x3,
+					 MI2S_SLOTS, MI2S_SLOT_WIDTH);
+	}
+}
+
 static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 {
 	unsigned int fmt = SND_SOC_DAIFMT_BP_FP;
@@ -86,7 +113,7 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT,
 			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		sm8250_snd_mi2s_codec_setup(rtd, codec_dai_fmt);
 		break;
 	case SECONDARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
@@ -94,7 +121,7 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			Q6AFE_LPASS_CLK_ID_SEC_MI2S_IBIT,
 			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		sm8250_snd_mi2s_codec_setup(rtd, codec_dai_fmt);
 		break;
 	case TERTIARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
@@ -102,7 +129,7 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			Q6AFE_LPASS_CLK_ID_TER_MI2S_IBIT,
 			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		sm8250_snd_mi2s_codec_setup(rtd, codec_dai_fmt);
 		break;
 	case QUATERNARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
@@ -110,7 +137,7 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			Q6AFE_LPASS_CLK_ID_QUAD_MI2S_IBIT,
 			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		sm8250_snd_mi2s_codec_setup(rtd, codec_dai_fmt);
 		break;
 	case QUINARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
@@ -118,7 +145,7 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			Q6AFE_LPASS_CLK_ID_QUI_MI2S_IBIT,
 			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		sm8250_snd_mi2s_codec_setup(rtd, codec_dai_fmt);
 		break;
 	case LPI_MI2S_RX_0:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
-- 
