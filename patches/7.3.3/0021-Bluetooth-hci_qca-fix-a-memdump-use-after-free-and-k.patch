From 1a50c61315d58600f8ff824798692bce4537ef38 Mon Sep 17 00:00:00 2001
From: Viktor Zaritskyi <viktorzarickiy@gmail.com>
Date: Mon, 7 Sep 2026 21:46:52 +0300
Subject: [PATCH 21/25] Bluetooth: hci_qca: fix a memdump use-after-free, and
 keep WCN3991 awake

Four fixes, all found on a WCN3991 attached over UART on SM7125.

qca_controller_memdump() cached qca->qca_memdump once, before its loop.
Completing a dump frees that buffer and clears the pointer, but the
stale copy stayed behind and was written through on the next iteration
-- which happens whenever the next dump's packets are already queued, as
they are when the controller crashes repeatedly. Re-read it every pass
and clear the pointer on the two error paths that free it.

qca_setup() never reset the IBS state machine, so a re-setup after a
controller crash started from whatever state the previous instance had
left behind.

This controller never answers a wake-up once the host has slept it: every
boot died with ibs_sent_sleeps=1 and Bluetooth then cycled on and off
forever. Add an ibs_host_sleep module parameter to keep it awake, rather
than assuming every QCA part recovers from host-initiated sleep.

Finally, it sets the extended advertising bit in its LE features but then
answers LE_READ_NUM_SUPPORTED_ADV_SETS with Command Disallowed, which
aborts initialisation. Add HCI_QUIRK_BROKEN_EXT_ADV for that, gate
ext_adv_capable() on it, and set it along with the existing broken
extended scan and create-connection quirks for wcn399x.

Signed-off-by: Viktor Zaritskyi <viktorzarickiy@gmail.com>
Assisted-by: Claude:claude-opus-5

[port 7.3: use hci_set_quirk()/hci_test_quirk() and timer_delete*();
 upstream already limits the missing-BT_EN power control fallback to
 WCN6750/WCN6855/WCN7850, kept that]

(cherry picked from commit d9fc14ecf17cbb521faf210807dcfd2952cdeb52)
---
 drivers/bluetooth/hci_qca.c      | 64 +++++++++++++++++++++++++++++++-
 include/net/bluetooth/hci.h      | 12 ++++++
 include/net/bluetooth/hci_core.h |  3 +-
 3 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 7089e9b639..75ed0a34ea 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -238,6 +238,13 @@ static void qca_power_off(struct hci_uart *hu);
 static void qca_controller_memdump(struct work_struct *work);
 static void qca_dmp_hdr(struct hci_dev *hdev, struct sk_buff *skb);
 
+static bool ibs_host_sleep = true;
+module_param(ibs_host_sleep, bool, 0644);
+MODULE_PARM_DESC(ibs_host_sleep,
+		 "Allow the host to put the controller to sleep over IBS (default true). "
+		 "On boards whose controller never answers the wake-up that follows, "
+		 "clear this to keep it awake instead.");
+
 static enum qca_btsoc_type qca_soc_type(struct hci_uart *hu)
 {
 	enum qca_btsoc_type soc_type;
@@ -482,6 +489,11 @@ static void hci_ibs_tx_idle_timeout(struct timer_list *t)
 	spin_lock_irqsave_nested(&qca->hci_ibs_lock,
 				 flags, SINGLE_DEPTH_NESTING);
 
+	if (!ibs_host_sleep) {
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+		return;
+	}
+
 	switch (qca->tx_ibs_state) {
 	case HCI_IBS_TX_AWAKE:
 		/* TX_IDLE, go to SLEEP */
@@ -1038,7 +1050,7 @@ static void qca_controller_memdump(struct work_struct *work)
 	struct hci_uart *hu = qca->hu;
 	struct sk_buff *skb;
 	struct qca_memdump_event_hdr *cmd_hdr;
-	struct qca_memdump_info *qca_memdump = qca->qca_memdump;
+	struct qca_memdump_info *qca_memdump;
 	struct qca_dump_size *dump;
 	u16 seq_no;
 	u32 rx_size;
@@ -1048,6 +1060,16 @@ static void qca_controller_memdump(struct work_struct *work)
 	while ((skb = skb_dequeue(&qca->rx_memdump_q))) {
 
 		mutex_lock(&qca->hci_memdump_lock);
+
+		/* Re-read this on every iteration. Completing a dump frees
+		 * the buffer and clears qca->qca_memdump, but a cached copy
+		 * would stay behind and be written through on the next pass,
+		 * which happens whenever the packets of the following dump
+		 * are already queued -- as they are when the controller
+		 * crashes repeatedly.
+		 */
+		qca_memdump = qca->qca_memdump;
+
 		/* Skip processing the received packets if timeout detected
 		 * or memdump collection completed.
 		 */
@@ -1127,6 +1149,7 @@ static void qca_controller_memdump(struct work_struct *work)
 		if (!test_bit(QCA_MEMDUMP_COLLECTION, &qca->flags)) {
 			bt_dev_err(hu->hdev, "QCA: Discarding other packets");
 			kfree(qca_memdump);
+			qca->qca_memdump = NULL;
 			kfree_skb(skb);
 			mutex_unlock(&qca->hci_memdump_lock);
 			return;
@@ -1921,6 +1944,7 @@ static int qca_setup(struct hci_uart *hu)
 	struct qca_btsoc_version ver;
 	struct qca_serdev *qcadev = NULL;
 	const char *soc_name;
+	unsigned long ibs_flags;
 
 	if (hu->serdev)
 		qcadev = serdev_device_get_drvdata(hu->serdev);
@@ -1949,6 +1973,26 @@ static int qca_setup(struct hci_uart *hu)
 	case QCA_WCN3991:
 	case QCA_WCN3998:
 		soc_name = "wcn399x";
+		/*
+		 * These claim extended advertising in their LE features but
+		 * answer HCI_OP_LE_READ_NUM_SUPPORTED_ADV_SETS with Command
+		 * Disallowed, which aborts initialisation and leaves the
+		 * controller down. They likewise claim the extended scanning
+		 * commands and then never answer LE Set Extended Scan
+		 * Parameters at all, so discovery times out.
+		 */
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_EXT_ADV);
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_EXT_SCAN);
+		/*
+		 * They advertise LE Extended Create Connection in their
+		 * supported commands as well, and answer it with Command
+		 * Disallowed, so no LE connection is ever established: every
+		 * attempt comes back as MGMT_STATUS_BUSY once the 0x0c reply
+		 * has been through -EBUSY and back. This is a separate quirk
+		 * from HCI_QUIRK_BROKEN_EXT_ADV -- use_ext_conn() does not
+		 * consult ext_adv_capable().
+		 */
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_EXT_CREATE_CONN);
 		break;
 
 	case QCA_WCN6750:
@@ -2032,6 +2076,21 @@ static int qca_setup(struct hci_uart *hu)
 	ret = qca_uart_setup(hdev, qca_baudrate, soc_type, ver,
 			firmware_name, rampatch_name);
 	if (!ret) {
+		/* A controller reset runs setup again but never runs
+		 * qca_open() again, so the IBS state machine can still be
+		 * sitting in HCI_IBS_TX_WAKING from the failure that caused
+		 * the reset -- with no retransmit timer left to carry it out
+		 * of that state. Every later packet would then queue behind a
+		 * wake-up that is never sent again, and the controller would
+		 * look dead until the next reboot.
+		 */
+		timer_delete_sync(&qca->wake_retrans_timer);
+		timer_delete_sync(&qca->tx_idle_timer);
+		spin_lock_irqsave(&qca->hci_ibs_lock, ibs_flags);
+		qca->tx_ibs_state = HCI_IBS_TX_ASLEEP;
+		qca->rx_ibs_state = HCI_IBS_RX_ASLEEP;
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, ibs_flags);
+
 		clear_bit(QCA_IBS_DISABLED, &qca->flags);
 		qca_debugfs_init(hdev);
 		hu->hdev->hw_error = qca_hw_error;
@@ -2710,6 +2769,9 @@ static int __maybe_unused qca_suspend(struct device *dev)
 	case HCI_IBS_TX_AWAKE:
 		timer_delete(&qca->tx_idle_timer);
 
+		if (!ibs_host_sleep)
+			break;
+
 		serdev_device_write_flush(hu->serdev);
 		cmd = HCI_IBS_SLEEP_IND;
 		ret = serdev_device_write_buf(hu->serdev, &cmd, sizeof(cmd));
diff --git a/include/net/bluetooth/hci.h b/include/net/bluetooth/hci.h
index 1641d879db..0bb689f830 100644
--- a/include/net/bluetooth/hci.h
+++ b/include/net/bluetooth/hci.h
@@ -281,6 +281,18 @@ enum {
 	 */
 	HCI_QUIRK_BROKEN_EXT_SCAN,
 
+	/*
+	 * When this quirk is set, extended advertising is treated as
+	 * unsupported. This is required for controllers which set the
+	 * extended advertising bit in their LE features but then answer
+	 * HCI_OP_LE_READ_NUM_SUPPORTED_ADV_SETS with Command Disallowed,
+	 * which otherwise fails initialisation and leaves the device down.
+	 *
+	 * This quirk can be set before hci_register_dev is called or
+	 * during the hdev->setup vendor callback.
+	 */
+	HCI_QUIRK_BROKEN_EXT_ADV,
+
 	/*
 	 * When this quirk is set, the HCI_OP_GET_MWS_TRANSPORT_CONFIG command is
 	 * disabled. This is required for some Broadcom controllers which
diff --git a/include/net/bluetooth/hci_core.h b/include/net/bluetooth/hci_core.h
index fa2a367731..09a215b81b 100644
--- a/include/net/bluetooth/hci_core.h
+++ b/include/net/bluetooth/hci_core.h
@@ -2043,7 +2043,8 @@ void hci_conn_del_sysfs(struct hci_conn *conn);
 #define use_ext_conn(dev) (((dev)->commands[37] & 0x80) && \
 	!hci_test_quirk((dev), HCI_QUIRK_BROKEN_EXT_CREATE_CONN))
 /* Extended advertising support */
-#define ext_adv_capable(dev) (((dev)->le_features[1] & HCI_LE_EXT_ADV))
+#define ext_adv_capable(dev) (((dev)->le_features[1] & HCI_LE_EXT_ADV) && \
+	!hci_test_quirk((dev), HCI_QUIRK_BROKEN_EXT_ADV))
 
 /* Maximum advertising length */
 #define max_adv_len(dev) \
-- 
2.53.0

