From 668869624199ea5ad0fd1c67153f860ea2df2953 Mon Sep 17 00:00:00 2001
From: Pliskin Industrie <pliskin-industrie@users.noreply.github.com>
Date: Sun, 8 Nov 2026 12:30:30 +0100
Subject: [PATCH 1/3] arm64: dts: qcom: gta4xlve: disable USB2 LPM and tune
 QUSB2 PHY

The USB gadget link (NCM/ssh) drops repeatedly with USB2 link power
management enabled. Disable gadget LPM like the vendor kernel does and
apply the vendor QUSB2 PHY tuning values (pre-emphasis 15 %, half bit,
HS disconnect trim 3, impedance offset 0x08, bias control 0x16).

Values were read from the vendor device tree of the stock firmware.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Pliskin Industrie <pliskin-industrie@users.noreply.github.com>
---
 .../boot/dts/qcom/sm7125-samsung-gta4xlve.dts   | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts b/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts
index c51569ec2b..2cc5f4de39 100644
--- a/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts
+++ b/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/phy/phy-qcom-qusb2.h>
 #include <dt-bindings/firmware/qcom,scm.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
@@ -293,3 +294,19 @@ tsp_int_default: tsp-int-default-state {
 &venus {
 	firmware-name = "qcom/sm7125/gta4xlve/venus.mbn";
 };
+
+&usb_1_dwc3 {
+	/* USB2 LPM (L1) in gadget mode causes link drops, as on the vendor kernel */
+	snps,usb2-gadget-lpm-disable;
+	snps,has-lpm-erratum;
+	snps,hird-threshold = /bits/ 8 <0x10>;
+};
+
+&usb_1_hsphy {
+	/* PHY tuning taken from the vendor device tree (TUNE1/TUNE2/IMP_CTRL1/BIAS_CTRL2) */
+	qcom,preemphasis-level = <QUSB2_V2_PREEMPHASIS_15_PERCENT>;
+	qcom,preemphasis-width = <QUSB2_V2_PREEMPHASIS_WIDTH_HALF_BIT>;
+	qcom,hsdisc-trim-value = <3>;
+	qcom,imp-res-offset-value = <0x08>;
+	qcom,bias-ctrl-value = <0x16>;
+};
