From df574693883568ae668c2fdbf843c11f4c7152a4 Mon Sep 17 00:00:00 2001
From: Viktor Zaritskyi <viktorzarickiy@gmail.com>
Date: Wed, 2 Sep 2026 21:38:49 +0300
Subject: [PATCH 15/25] arm64: dts: qcom: add Samsung Galaxy Tab S6 Lite
 (gta4xlve) DTS

(cherry picked from commit 9d5ca0b30cae2938965bc839fc9d452e0e52788d)
---
 arch/arm64/boot/dts/qcom/Makefile             |  1 +
 .../boot/dts/qcom/sm7125-samsung-gta4xlve.dts | 62 +++++++++++++++++++
 2 files changed, 63 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index a320cbf827..316d2dd254 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -274,6 +274,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm7125-samsung-a52q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm7125-samsung-a72q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm7125-xiaomi-curtana.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm7125-xiaomi-joyeuse.dtb
+dtb-$(CONFIG_ARCH_QCOM) += sm7125-samsung-gta4xlve.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm7225-fairphone-fp4.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm7325-nothing-spacewar.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-hdk.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts b/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts
new file mode 100644
index 0000000000..da675a3b24
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7125-samsung-gta4xlve.dts
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SM7125 Samsung Galaxy Tab S6 Lite (2022) (gta4xlve) device tree
+ */
+
+/dts-v1/;
+
+#include "sm7125-samsung-common.dtsi"
+
+/ {
+	model = "Samsung Galaxy Tab S6 Lite (2022)";
+	compatible = "samsung,gta4xlve", "qcom,sm7125";
+	qcom,board-id = <0x22 0x5>;
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		rmtfs_mem: memory@f3700000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0 0xf3700000 0 0x202000>;
+			qcom,use-guard-pages;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+		};
+	};
+};
+
+&bluetooth {
+	firmware-name = "sm7125/gta4xlve/apnv11.bin";
+};
+
+&display_panel {
+	compatible = "tianma,fhd-video";
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm7125/gta4xlve/a615_zap.mbn";
+};
+
+&ipa {
+	status = "okay";
+	firmware-name = "qcom/sm7125/gta4xlve/ipa_fws.mbn";
+};
+
+&remoteproc_adsp {
+	status = "okay";
+	firmware-name = "qcom/sm7125/gta4xlve/adsp.mbn";
+};
+
+&remoteproc_cdsp {
+	status = "okay";
+	firmware-name = "qcom/sm7125/gta4xlve/cdsp.mbn";
+};
+
+&sound {
+	model = "Galaxy Tab S6 Lite";
+};
-- 
